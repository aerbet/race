# Скопируй в deploy/.env и заполни. Файл .env в git не попадает.
# Домен игры (A-запись на IP сервера). HTTPS выпускается автоматически.
DOMAIN=
# Пароль PostgreSQL
DB_PASSWORD=
# Подпись токенов игроков: случайная строка не короче 32 символов (openssl rand -hex 32)
JWT_SECRET=
# Ключ между API и сервером гонок: не короче 16 символов (openssl rand -hex 16)
INTERNAL_KEY=
# Telegram: бот (вход, Mini App, оплата Stars) и секрет вебхука (openssl rand -hex 16)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Необязательно: Crypto Pay (@CryptoBot) и ЮKassa (СБП). Пусто — способ оплаты выключен
CRYPTOPAY_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPTS=false
# Необязательно: ключ YouTube Data API (проверка встраивания роликов)
VITE_YT_API_KEY=
