{
  "name": "street-racer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter client dev",
    "build": "pnpm --filter client build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node e2e/smoke.mjs",
    "server": "pnpm --filter race-server dev",
    "api": "cd apps/api && mvn -q spring-boot:run",
    "api:test": "cd apps/api && mvn -q test"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "22.13.0",
    "eslint": "9.19.0",
    "eslint-config-prettier": "10.0.1",
    "playwright": "1.63.0",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.22.0",
    "vite": "6.0.11",
    "vitest": "3.0.5"
  }
}
